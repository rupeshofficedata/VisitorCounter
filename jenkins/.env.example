# Host-specific values - copy this file to .env and fill in per machine.
# Find yours with:
#   which docker              -> DOCKER_BIN
#   stat -c '%g' /var/run/docker.sock -> DOCKER_GID
#   dir holding docker-buildx (often /usr/lib/docker/cli-plugins) -> DOCKER_PLUGINS
DOCKER_BIN=/usr/bin/docker
DOCKER_GID=999
DOCKER_PLUGINS=/usr/lib/docker/cli-plugins
